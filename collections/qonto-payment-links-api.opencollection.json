{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qonto Business Cards Payment Links API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Payment Links",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List payment links",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://thirdparty.qonto.com/v2/payment_links"
          },
          "docs": "OAuth scope: payment_link.read"
        },
        {
          "info": {
            "name": "Create a payment link",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://thirdparty.qonto.com/v2/payment_links"
          },
          "docs": "OAuth scope: payment_link.write"
        }
      ]
    }
  ],
  "bundled": true
}