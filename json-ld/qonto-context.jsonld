{
  "@context": {
    "@vocab": "https://qonto.com/schema#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "qonto": "https://qonto.com/schema#",
    "TokenSet": "qonto:TokenSet",
    "access_token": {
      "@id": "qonto:access_token",
      "@type": "xsd:string"
    },
    "token_type": {
      "@id": "qonto:token_type",
      "@type": "xsd:string"
    },
    "expires_in": {
      "@id": "qonto:expires_in",
      "@type": "xsd:integer"
    },
    "refresh_token": {
      "@id": "qonto:refresh_token",
      "@type": "xsd:string"
    },
    "id_token": {
      "@id": "qonto:id_token",
      "@type": "xsd:string"
    },
    "scope": {
      "@id": "qonto:scope",
      "@type": "xsd:string"
    },
    "SepaTransferRequest": "qonto:SepaTransferRequest",
    "debit_iban": {
      "@id": "qonto:debit_iban",
      "@type": "xsd:string"
    },
    "beneficiary_id": {
      "@id": "qonto:beneficiary_id",
      "@type": "xsd:string"
    },
    "amount": {
      "@id": "qonto:amount",
      "@type": "xsd:string"
    },
    "currency": {
      "@id": "qonto:currency",
      "@type": "xsd:string"
    },
    "reference": {
      "@id": "qonto:reference",
      "@type": "xsd:string"
    },
    "instant": {
      "@id": "qonto:instant",
      "@type": "xsd:boolean"
    },
    "scheduled_date": {
      "@id": "qonto:scheduled_date",
      "@type": "xsd:date"
    },
    "attachment_ids": {
      "@id": "qonto:attachment_ids",
      "@container": "@list"
    }
  },
  "@type": "schema:Dataset",
  "schema:name": "Qonto API JSON-LD context",
  "schema:description": "A JSON-LD @context for the objects Qonto's own API contract declares: one class per component schema, one property per declared field, typed from the contract. Derived by script (derive-json-ld.py, 2026-10-12) from openapi/qonto-cards-api-openapi.yml, openapi/qonto-client-invoices-api-openapi.yml, openapi/qonto-internal-transfers-api-openapi.yml.",
  "dcterms:created": "2026-10-12",
  "dcterms:source": [
    "openapi/qonto-cards-api-openapi.yml",
    "openapi/qonto-client-invoices-api-openapi.yml",
    "openapi/qonto-internal-transfers-api-openapi.yml",
    "openapi/qonto-international-transfers-api-openapi.yml",
    "openapi/qonto-oauth-api-openapi.yml"
  ]
}